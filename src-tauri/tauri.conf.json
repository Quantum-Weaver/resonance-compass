{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Resonance Compass",
  "version": "2.3.8",
  "identifier": "com.audhd.resonance-compass",
  "build": {
    "beforeDevCommand": "node C:/_superposition/resonance-ziggy/modules/android-extras/sync-android-extras.mjs resonance-compass && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node C:/_superposition/resonance-ziggy/modules/android-extras/sync-android-extras.mjs resonance-compass && npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Resonance Compass",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://tauri.localhost; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
